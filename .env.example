# External Services (YOU MUST PROVIDE THESE)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dsb
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=sk-...

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=DEBUG
CACHE_ENABLED=false

# Embedding Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
LOCAL_EMBEDDING_MODEL_PATH=

# Vector Index
VECTOR_INDEX=hnsw
HNSW_M=16
HNSW_EF_CONSTRUCTION=128
HNSW_EF_SEARCH=64

# Clustering
CLUSTERING_ENABLED_EMBEDDING=true
CLUSTERING_ENABLED_TAG=true
CLUSTERING_ENABLED_TOPIC=true
CLUSTERING_ENABLED_FUSION=true
ASSIGN_THRESHOLD=0.75
TAG_MIN_DOCS=5
TOPIC_MIN_DOCS=3
TOPIC_REUSE_THRESHOLD=0.82
FUSION_WEIGHTS={"emb":0.6,"tag":0.2,"topic":0.2}

# Document Processing
TOPIC_MAX_PER_DOC=5
TAG_EXTRACTOR=llm+yake
TAG_NORMALIZE=true
DOC_ENGINE=MD_JINJA
STORAGE_MODE=local
LOCAL_STORAGE_PATH=./generated_docs
TEMPLATE_INPUT_MAX_BYTES=1048576
TEMPLATE_ALLOWED_MIMES=text/markdown,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document
MARKDOWN_ENGINE=markdown-it-py
PANDOC_ENABLED=false

# API Settings
ALLOW_PUBLIC_POST=true
ALLOW_ANONYMOUS_POST=false
PII_REDACTION=true
RATE_LIMIT_PUBLIC_POST=60
MAX_BODY_CHARS=10000

# Workers
UVICORN_WORKERS=2
UVICORN_HOST=0.0.0.0
UVICORN_PORT=9000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=